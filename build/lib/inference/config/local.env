# local 프로파일(개발자 PC). deploy/local/docker-compose.yml의 minio·api 주소.
# 비밀값(MINIO_ACCESS_KEY, MINIO_SECRET_KEY, INTERNAL_TOKEN)은 여기 넣지 말고 환경변수로 준다.
STORAGE_BACKEND=s3
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=notebook-rental
API_BASE_URL=http://localhost:8080
MODEL_CACHE_DIR=./.data/models
MAX_CONCURRENT_COMPARES=2
