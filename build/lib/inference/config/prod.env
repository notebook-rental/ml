# prod 프로파일(Kubernetes). 비밀값은 Secret notebook-rental-secrets → 환경변수.
# MINIO_ENDPOINT도 Secret에서 온다(docs infra/README.md).
STORAGE_BACKEND=s3
MINIO_BUCKET=notebook-rental
API_BASE_URL=http://api:8080
MODEL_CACHE_DIR=/var/cache/models
MAX_CONCURRENT_COMPARES=2
# 운영 백본: 공식 DINOv2 ViT-S/14 → ONNX (ml repo Release model-dinov2-s14-v1, export-model 워크플로)
# 버킷에 models/dinov2-s14/model.onnx 가 없으면 이 주소에서 받아 해시를 확인하고 버킷에 채운다.
BACKBONE_URL=https://github.com/notebook-rental/ml/releases/download/model-dinov2-s14-v1/model.onnx
BACKBONE_SHA256=a90658ae2097c5e009f385fe5eec919d98196ff485cd8f89023d6b153c13d7cf
